# ==============================================================================
# EVALORA FRONTEND CONFIGURATION (.env.example)
# Client environment configuration for Vite
# ==============================================================================

# API Base URL (leave blank or '/api' when using Vite dev proxy or same-origin reverse proxy;
# set to your production API URL e.g. 'https://api.evalora.com/api' for cross-origin deployments)
VITE_API_URL=/api
