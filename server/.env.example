# ==============================================================================
# EVALORA BACKEND CONFIGURATION (.env.example)
# Safe template for development and production deployment.
# Replace all placeholder values with your environment-specific credentials.
# ==============================================================================

# Server Core Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/evalora

# JWT Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (Optional: required only for Google Auth flow)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Optional SMTP settings for assessment invitations and reminders
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME=Evalora
SMTP_FROM_EMAIL=your_email@gmail.com

# Optional HTTPS email API settings
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Wallet challenge policy
AUTH_CHALLENGE_MAX_ATTEMPTS=5

# AI Question Generation (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
GEMINI_MODEL=gemini-3.8-flash
AI_AUTO_REPLENISH=true
AI_FORCE_FRESH_EVERY_TIME=true

# Algorand & Pera Wallet Payment Verification (Rule: All plans must be < 9 ALGO)
EVALORA_ADMIN_EMAIL=admin@evalora.test
EVALORA_ADMIN_WALLET=WLLFEO5GNYDMQTM3RWKC6MTMQDI6QUZEVQF22JPKKOECX2N24CZWYJM2BA
EVALORA_PAYMENT_WALLET=WLLFEO5GNYDMQTM3RWKC6MTMQDI6QUZEVQF22JPKKOECX2N24CZWYJM2BA
ALGOD_NETWORK=testnet
ALGORAND_NETWORK=testnet
